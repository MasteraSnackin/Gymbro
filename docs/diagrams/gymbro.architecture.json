  "cards": [
    {
      "dot": "cyan",
      "title": "Data and custody",
      "items": [
        "Normal upload reads the raw video in the browser; sampled JPEGs go to /api/scan.",
        "Coach requests also send a cropped JPEG, keypoints and measured angles.",
        "Results live in browser memory. No database or durable history is implemented."
      ]
    },
    {
      "dot": "amber",
      "title": "Fallbacks and image checks",
      "items": [
        "Unconfigured scan providers are skipped; failures or empty events try the next provider.",
        "Provider failure can use local pose/rules or a target skeleton.",
        "Image pass checks one primary metric with 10 degree-equivalents of tolerance; one retry requires the first edit to finish in under 45 s."
      ]
    },
    {
      "dot": "slate",
      "title": "Cached demo and evidence",
      "items": [
        "Default demo loads synthetic reports and real clip assets; animation does not prove live calls.",
        "Bundled after.jpg is a later original clip frame, marked placeholderAfter in meta.json.",
        "Code map at 90fc50b. Live provider behaviour and deployment were not tested. MOCK_AI=1 returns fixtures through the API routes."
      ]
    }
